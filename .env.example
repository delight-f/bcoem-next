APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=
# DB_TABLE_PREFIX=
# DB_SSLMODE=prefer

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Mail. The transport is normally chosen in the admin UI
# (Site Preferences -> Email), which overrides these values at runtime.
# MAIL_MAILER is only the fallback used until a transport is selected there.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Used by the "this server's own mail program" transport. Shared/cPanel hosts
# that block outbound SMTP (e.g. nfshost) usually want: /usr/sbin/sendmail -t -i
MAIL_SENDMAIL_PATH="/usr/sbin/sendmail -t -i"

# HTTPS mail providers: leave blank when configuring the key in the admin UI.
# These send over port 443, so a blocked SMTP port does not matter.
RESEND_API_KEY=
POSTMARK_API_KEY=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Stripe Connect (P3.5b) — platform OAuth client + secret key.
STRIPE_CLIENT_ID=
STRIPE_SECRET=

# PayPal (issue #24) — per-install. Provide all three to enable PayPal.
# mode: sandbox | live. webhook_id comes from the PayPal app's webhook config.
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
# PAYPAL_CURRENCY=
# PAYPAL_APP_ID=

# Signup bot/spam protection. All layers are off by default or fail open
# unless deliberately enabled, so a fresh install's registration works
# unchanged. Each can be toggled independently.

# Honeypot (spatie/laravel-honeypot): a hidden field real browsers leave
# blank. No setup cost, so it ships enabled. Set false to remove it.
# The remaining keys tune the hidden field; the defaults below are what the
# package ships and rarely need changing.
HONEYPOT_ENABLED=true
# HONEYPOT_NAME=my_name
# HONEYPOT_RANDOMIZE=true
# HONEYPOT_SECONDS=1
# HONEYPOT_VALID_FROM=valid_from
# HONEYPOT_VALID_FROM_TIMESTAMP=true
# HONEYPOT_WITH_CSP=false

# Cloudflare Turnstile (bots). Get free keys at
# https://dash.cloudflare.com/?to=/:account/turnstile. If enabled, the
# keys must be valid — signups fail closed (a bad key rejects signups and
# logs a config error) rather than silently skipping the check.
TURNSTILE_ENABLED=false
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Require entrants to confirm their email before adding entries or paying.
# Only for hosts with working outbound mail — test your mail settings
# before enabling. Off by default so a host without mail cannot lock
# users out of a flow they never opted into.
EMAIL_VERIFICATION_ENABLED=false

# Central clubs list (issue #22). The published JSON artifact that the
# `clubs:sync` command mirrors into the local clubs table. Override only if
# you mirror the artifact somewhere else; the default points at the public
# upstream-published file.
CLUBS_LIST_URL=https://raw.githubusercontent.com/delight-f/clubs-list/main/dist/clubs.json
CLUBS_LIST_TIMEOUT=10

# Release checking (issue 27). The admin dashboard checks the latest published
# GitHub release for this repository at most once a day; a host with no
# outbound access simply shows no notice. Support email is the pre-filled
# "Contact support" address on the upgrade failure screen.
BCOEM_GITHUB_REPOSITORY=bcoem/bcoem-next
# BCOEM_GITHUB_TIMEOUT=5
BCOEM_SUPPORT_EMAIL=support@brewingcompetitions.com
